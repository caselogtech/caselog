{
  "name": "@caselog/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Caselog API schemas",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "browser": "./src/evidence.ts",
      "default": "./dist/evidence.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "browser": "./src/readiness.ts",
      "default": "./dist/readiness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
