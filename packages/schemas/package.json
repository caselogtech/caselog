{
  "name": "@caselog/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Caselog API schemas",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./api-error": {
      "types": "./dist/api-error.d.ts",
      "browser": "./src/api-error.ts",
      "default": "./dist/api-error.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "browser": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "browser": "./src/instance.ts",
      "default": "./dist/instance.js"
    },
    "./invitation": {
      "types": "./dist/invitation.d.ts",
      "browser": "./src/invitation.ts",
      "default": "./dist/invitation.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "browser": "./src/evidence.ts",
      "default": "./dist/evidence.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "browser": "./src/readiness.ts",
      "default": "./dist/readiness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
