NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
WEB_BASE_URL=http://localhost:4200
LOG_LEVEL=info

# Instance capabilities exposed to the application UI and enforced by the API.
CASELOG_DEPLOYMENT_MODE=self_hosted
CASELOG_INSTANCE_NAME=Caselog
CASELOG_REGISTRATION_MODE=public
CASELOG_WORKSPACE_CREATION_ENABLED=true
# Optional positive safety limit. Empty means unlimited, including for self-hosted use.
CASELOG_MAX_WORKSPACES_PER_USER=
# Valid only when CASELOG_DEPLOYMENT_MODE=managed.
CASELOG_MANAGED_BILLING_ENABLED=false

MIGRATION_DATABASE_URL=postgresql://caselog:caselog@localhost:5432/caselog?schema=public
DATABASE_URL=postgresql://caselog:caselog@localhost:5432/caselog?schema=public&options=-c%20role%3Dcaselog_app
JOB_DATABASE_URL=postgresql://caselog:caselog@localhost:5432/caselog
ISSUE_TRACKER_SYNC_CRON="*/5 * * * *"

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=caselog
S3_ACCESS_KEY=caselog
S3_SECRET_KEY=caselog-local-development
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_MAINTENANCE_CRON="15 * * * *"
STORAGE_MAINTENANCE_BATCH_SIZE=200
STORAGE_ORPHAN_GRACE_HOURS=24
STORAGE_RECHECK_HOURS=24
WORKSPACE_PURGE_CRON="30 2 * * *"
WORKSPACE_PURGE_OBJECT_BATCH_SIZE=200
WORKSPACE_PURGE_MAX_BATCHES_PER_JOB=5

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Caselog <noreply@caselog.local>
MAIL_SECURE=false

AUTH_SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ORGANIZATION_TOKEN_SECRET=replace-with-a-different-32-character-secret
# Production: generate with `openssl rand -base64 32`; re-encrypt credentials before changing it.
# INTEGRATION_CREDENTIAL_MASTER_KEY=
INTEGRATION_CREDENTIAL_KEY_VERSION=v1
INTEGRATION_ALLOW_PRIVATE_NETWORKS=true
AUTH_SESSION_TOKEN_TTL_SECONDS=900
AUTH_ORGANIZATION_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
WORKSPACE_INVITATION_TTL_DAYS=7
