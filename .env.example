NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
WEB_BASE_URL=http://localhost:4200

MIGRATION_DATABASE_URL=postgresql://caselog:caselog@localhost:5432/caselog?schema=public
DATABASE_URL=postgresql://caselog:caselog@localhost:5432/caselog?schema=public&options=-c%20role%3Dcaselog_app

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=caselog
S3_ACCESS_KEY=caselog
S3_SECRET_KEY=caselog-local-development
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_UPLOAD_URL_TTL_SECONDS=900

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Caselog <noreply@caselog.local>
MAIL_SECURE=false

AUTH_SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ORGANIZATION_TOKEN_SECRET=replace-with-a-different-32-character-secret
AUTH_SESSION_TOKEN_TTL_SECONDS=900
AUTH_ORGANIZATION_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
