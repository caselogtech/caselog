{
  "name": "@caselog/api",
  "version": "0.0.0",
  "description": "Caselog public API",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "prebuild": "pnpm --filter @caselog/schemas build && pnpm prisma:generate",
    "build": "nest build",
    "predev": "pnpm --filter @caselog/schemas build && pnpm prisma:generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "pretest": "pnpm --filter @caselog/schemas build && pnpm prisma:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@caselog/schemas": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "nestjs-zod": "5.5.0",
    "nodemailer": "9.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.3",
    "prisma": "7.9.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "tsx": "4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
