generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER       @map("owner")
  ADMIN       @map("admin")
  LEAD        @map("lead")
  TESTER      @map("tester")
  CONTRIBUTOR @map("contributor")
  READ_ONLY   @map("read_only")

  @@map("membership_role")
}

enum CaseTemplate {
  STEPS       @map("steps")
  TEXT        @map("text")
  EXPLORATORY @map("exploratory")
  BDD         @map("bdd")

  @@map("case_template")
}

enum RunStatus {
  DRAFT     @map("draft")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  ARCHIVED  @map("archived")

  @@map("run_status")
}

enum EnvironmentState {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("environment_state")
}

enum ReleaseState {
  DRAFT     @map("draft")
  ACTIVE    @map("active")
  RELEASED  @map("released")
  CANCELLED @map("cancelled")

  @@map("release_state")
}

enum CandidateTestRunRole {
  REQUIRED      @map("required")
  INFORMATIONAL @map("informational")

  @@map("candidate_test_run_role")
}

enum EvidenceTrustLevel {
  VERIFIED      @map("verified")
  AUTHENTICATED @map("authenticated")
  UNVERIFIED    @map("unverified")

  @@map("evidence_trust_level")
}

enum EvidenceValueType {
  PERCENTAGE @map("percentage")
  INTEGER    @map("integer")

  @@map("evidence_value_type")
}

enum EvidenceObservationState {
  AVAILABLE  @map("available")
  INCOMPLETE @map("incomplete")

  @@map("evidence_observation_state")
}

enum ReleasePolicyVersionState {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  RETIRED   @map("retired")

  @@map("release_policy_version_state")
}

enum ReadinessGateOperator {
  EQ  @map("eq")
  NE  @map("ne")
  GT  @map("gt")
  GTE @map("gte")
  LT  @map("lt")
  LTE @map("lte")

  @@map("readiness_gate_operator")
}

enum ReadinessGateImpact {
  WARNING  @map("warning")
  BLOCKING @map("blocking")

  @@map("readiness_gate_impact")
}

enum ReadinessEvidenceBehavior {
  UNKNOWN @map("unknown")
  WARN    @map("warn")
  BLOCK   @map("block")

  @@map("readiness_evidence_behavior")
}

enum GateEvaluationResult {
  PASSED  @map("passed")
  WARNING @map("warning")
  FAILED  @map("failed")
  UNKNOWN @map("unknown")

  @@map("gate_evaluation_result")
}

enum GateEvaluationDiagnostic {
  NONE       @map("none")
  MISSING    @map("missing")
  INCOMPLETE @map("incomplete")
  STALE      @map("stale")
  UNTRUSTED  @map("untrusted")

  @@map("gate_evaluation_diagnostic")
}

enum ReadinessDecisionStatus {
  READY   @map("ready")
  AT_RISK @map("at_risk")
  BLOCKED @map("blocked")
  UNKNOWN @map("unknown")

  @@map("readiness_decision_status")
}

enum ReadinessEvaluationTrigger {
  MANUAL           @map("manual")
  EVIDENCE_CHANGED @map("evidence_changed")
  POLICY_ASSIGNED  @map("policy_assigned")
  RECONCILIATION   @map("reconciliation")

  @@map("readiness_evaluation_trigger")
}

enum ReadinessProjectionState {
  PENDING @map("pending")
  CURRENT @map("current")
  STALE   @map("stale")
  FAILED  @map("failed")

  @@map("readiness_projection_state")
}

enum CustomFieldType {
  TEXT        @map("text")
  SELECT      @map("select")
  MULTISELECT @map("multiselect")
  NUMBER      @map("number")
  DATE        @map("date")
  USER        @map("user")
  URL         @map("url")
  CHECKBOX    @map("checkbox")

  @@map("custom_field_type")
}

enum CustomFieldEntityType {
  CASE        @map("case")
  RUN         @map("run")
  RESULT      @map("result")
  DEFECT_LINK @map("defect_link")
  MILESTONE   @map("milestone")

  @@map("custom_field_entity_type")
}

enum AttachmentTargetType {
  CASE_VERSION @map("case_version")
  RESULT       @map("result")

  @@map("attachment_target_type")
}

enum AttachmentStorageStatus {
  HEALTHY  @map("healthy")
  MISSING  @map("missing")
  MISMATCH @map("mismatch")

  @@map("attachment_storage_status")
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("account_token_purpose")
}

enum ApiTokenScope {
  RESULTS_WRITE  @map("results:write")
  RUNS_READ      @map("runs:read")
  EVIDENCE_WRITE @map("evidence:write")

  @@map("api_token_scope")
}

enum ResultIngestionFormat {
  JUNIT @map("junit")

  @@map("result_ingestion_format")
}

enum ResultIngestionStatus {
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("result_ingestion_status")
}

model Organization {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @unique(map: "uq_organizations_slug") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  purgeStartedAt DateTime? @map("purge_started_at") @db.Timestamptz(3)

  memberships                 Membership[]
  projects                    Project[]
  suites                      Suite[]
  sections                    Section[]
  testCases                   TestCase[]
  testCaseVersions            TestCaseVersion[]
  resultStatuses              ResultStatus[]
  testRuns                    TestRun[]
  resultIngestions            TestResultIngestion[]
  runProgressSnapshots        RunProgressSnapshot[]
  projectionRevisions         ProjectionRevision[]
  testRunItems                TestRunItem[]
  testResults                 TestResult[]
  testStepResults             TestStepResult[]
  uploadSessions              UploadSession[]
  attachmentBlobs             AttachmentBlob[]
  attachments                 Attachment[]
  customFieldDefinitions      CustomFieldDefinition[]
  customFieldValues           CustomFieldValue[]
  usageCounter                UsageCounter?
  idempotencyRecords          IdempotencyRecord[]
  apiTokens                   ApiToken[]
  integrationConnections      IntegrationConnection[]
  issueLinks                  IssueLink[]
  issueCreationRequests       IssueCreationRequest[]
  auditLogs                   AuditLog[]
  invitations                 WorkspaceInvitation[]
  slugRedirects               OrganizationSlugRedirect[]
  storageMaintenanceCursor    StorageMaintenanceCursor?
  environments                Environment[]
  releases                    Release[]
  releaseCandidates           ReleaseCandidate[]
  candidateTestRuns           CandidateTestRun[]
  releaseLifecycleEvents      ReleaseLifecycleEvent[]
  integrationEvents           IntegrationEvent[]
  integrationEventReceipts    IntegrationEventReceipt[]
  evidenceProducers           EvidenceProducer[]
  evidenceObservations        EvidenceObservation[]
  candidateEvidenceRevisions  CandidateEvidenceRevision[]
  currentEvidenceObservations CurrentEvidenceObservation[]
  releasePolicies             ReleasePolicy[]
  releasePolicyVersions       ReleasePolicyVersion[]
  readinessGates              ReadinessGate[]
  candidatePolicyAssignments  CandidatePolicyAssignment[]
  currentPolicyAssignments    CurrentCandidatePolicyAssignment[]
  readinessDecisions          ReadinessDecision[]
  gateEvaluations             GateEvaluation[]
  currentReadinessDecisions   CurrentReadinessDecision[]

  @@index([deletedAt, purgeStartedAt, id], map: "idx_organizations_workspace_purge")
  @@map("organizations")
}

model OrganizationSlugRedirect {
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @unique(map: "uq_organization_slug_redirects_slug") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, slug], map: "pk_organization_slug_redirects")
  @@map("organization_slug_redirects")
}

model IdempotencyRecord {
  organizationId String   @map("organization_id") @db.Uuid
  scope          String   @db.VarChar(200)
  key            String   @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.Char(64)
  response       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '7 days'")) @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, scope, key], map: "pk_idempotency_records")
  @@index([organizationId, expiresAt], map: "idx_idempotency_records_organization_id_expires_at")
  @@map("idempotency_records")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique(map: "uq_users_email") @db.Citext
  displayName     String    @map("display_name") @db.VarChar(120)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  memberships              Membership[]
  authoredVersions         TestCaseVersion[]           @relation("VersionAuthor")
  assignedRunItems         TestRunItem[]               @relation("RunItemAssignee")
  executedResults          TestResult[]                @relation("ResultExecutor")
  passwordCredential       PasswordCredential?
  authSessions             AuthSession[]
  accountTokens            AccountToken[]
  createdUploads           UploadSession[]             @relation("UploadCreator")
  apiTokens                ApiToken[]                  @relation("ApiTokenCreator")
  integrationConnections   IntegrationConnection[]     @relation("IntegrationConnectionCreator")
  createdIssueLinks        IssueLink[]                 @relation("IssueLinkCreator")
  issueCreationRequests    IssueCreationRequest[]      @relation("IssueCreationRequestCreator")
  sentInvitations          WorkspaceInvitation[]       @relation("InvitationSender")
  resultIngestions         TestResultIngestion[]       @relation("ResultIngestionInitiator")
  createdEnvironments      Environment[]               @relation("EnvironmentCreator")
  createdReleases          Release[]                   @relation("ReleaseCreator")
  createdCandidates        ReleaseCandidate[]          @relation("ReleaseCandidateCreator")
  linkedCandidateRuns      CandidateTestRun[]          @relation("CandidateTestRunCreator")
  releaseLifecycleEvents   ReleaseLifecycleEvent[]     @relation("ReleaseLifecycleActor")
  createdReadinessPolicies ReleasePolicy[]             @relation("ReleasePolicyCreator")
  createdPolicyVersions    ReleasePolicyVersion[]      @relation("ReleasePolicyVersionCreator")
  publishedPolicyVersions  ReleasePolicyVersion[]      @relation("ReleasePolicyVersionPublisher")
  policyAssignments        CandidatePolicyAssignment[] @relation("CandidatePolicyAssigner")
  readinessDecisions       ReadinessDecision[]         @relation("ReadinessDecisionEvaluator")

  @@map("users")
}

model ApiToken {
  organizationId String          @map("organization_id") @db.Uuid
  id             String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  name           String          @db.VarChar(100)
  tokenPrefix    String          @map("token_prefix") @db.VarChar(12)
  tokenHash      String          @unique(map: "uq_api_tokens_token_hash") @map("token_hash") @db.Char(64)
  scopes         ApiTokenScope[]
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?       @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiTokenCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([organizationId, id], map: "pk_api_tokens")
  @@index([organizationId, revokedAt, expiresAt], map: "idx_api_tokens_organization_id_active")
  @@index([organizationId, createdAt], map: "idx_api_tokens_organization_id_created_at")
  @@map("api_tokens")
}

model AuditLog {
  organizationId String   @map("organization_id") @db.Uuid
  id             String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(30)
  action         String   @db.VarChar(100)
  targetType     String   @map("target_type") @db.VarChar(80)
  targetId       String?  @map("target_id") @db.VarChar(200)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id], map: "pk_audit_logs")
  @@index([organizationId, createdAt, id], map: "idx_audit_logs_organization_id_created_at_id")
  @@index([organizationId, action, createdAt], map: "idx_audit_logs_organization_id_action_created_at")
  @@map("audit_logs")
}

model IntegrationConnection {
  organizationId       String    @map("organization_id") @db.Uuid
  id                   String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String    @db.VarChar(50)
  deployment           String    @db.VarChar(50)
  name                 String    @db.VarChar(120)
  baseUrl              String    @map("base_url") @db.VarChar(2048)
  authType             String    @map("auth_type") @db.VarChar(50)
  encryptedCredentials Json      @map("encrypted_credentials")
  status               String    @default("active") @db.VarChar(20)
  lastError            String?   @map("last_error") @db.Text
  syncCheckpoint       Json?     @map("sync_checkpoint")
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(3)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdById          String?   @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User?                  @relation("IntegrationConnectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  issueLinks            IssueLink[]
  issueCreationRequests IssueCreationRequest[]

  @@id([organizationId, id], map: "pk_integration_connections")
  @@index([organizationId, provider, deletedAt], map: "idx_integration_connections_organization_provider")
  @@map("integration_connections")
}

model IssueLink {
  organizationId       String    @map("organization_id") @db.Uuid
  id                   String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  connectionId         String    @map("connection_id") @db.Uuid
  linkType             String    @map("link_type") @db.VarChar(30)
  testCaseId           String?   @map("test_case_id") @db.Uuid
  testResultId         String?   @map("test_result_id") @db.Uuid
  testResultExecutedAt DateTime? @map("test_result_executed_at") @db.Timestamptz(3)
  externalIssueId      String    @map("external_issue_id") @db.VarChar(255)
  externalIssueKey     String    @map("external_issue_key") @db.VarChar(255)
  title                String    @db.VarChar(500)
  url                  String    @db.VarChar(2048)
  issueType            String    @map("issue_type") @db.VarChar(120)
  statusId             String?   @map("status_id") @db.VarChar(255)
  statusName           String?   @map("status_name") @db.VarChar(255)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(3)
  lastSyncAttemptAt    DateTime? @map("last_sync_attempt_at") @db.Timestamptz(3)
  syncError            String?   @map("sync_error") @db.Text
  createdById          String?   @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  connection   IntegrationConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict)
  testCase     TestCase?             @relation(fields: [organizationId, testCaseId], references: [organizationId, id], onDelete: Restrict)
  testResult   TestResult?           @relation(fields: [organizationId, testResultId, testResultExecutedAt], references: [organizationId, id, executedAt], onDelete: Restrict)
  createdBy    User?                 @relation("IssueLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([organizationId, id], map: "pk_issue_links")
  @@index([organizationId, projectId, deletedAt], map: "idx_issue_links_organization_project")
  @@index([organizationId, connectionId, externalIssueId], map: "idx_issue_links_external_issue")
  @@index([organizationId, testCaseId, deletedAt], map: "idx_issue_links_test_case")
  @@index([organizationId, testResultId, testResultExecutedAt, deletedAt], map: "idx_issue_links_test_result")
  @@map("issue_links")
}

model IssueCreationRequest {
  organizationId       String   @map("organization_id") @db.Uuid
  id                   String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  connectionId         String   @map("connection_id") @db.Uuid
  testResultId         String   @map("test_result_id") @db.Uuid
  testResultExecutedAt DateTime @map("test_result_executed_at") @db.Timestamptz(3)
  idempotencyKey       String   @map("idempotency_key") @db.VarChar(200)
  requestHash          String   @map("request_hash") @db.Char(64)
  state                String   @default("pending") @db.VarChar(40)
  response             Json?
  lastError            String?  @map("last_error") @db.Text
  createdById          String?  @map("created_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  connection   IntegrationConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict)
  testResult   TestResult            @relation(fields: [organizationId, testResultId, testResultExecutedAt], references: [organizationId, id, executedAt], onDelete: Restrict)
  createdBy    User?                 @relation("IssueCreationRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([organizationId, id], map: "pk_issue_creation_requests")
  @@unique([organizationId, idempotencyKey], map: "uq_issue_creation_requests_organization_key")
  @@index([organizationId, connectionId, state, updatedAt], map: "idx_issue_creation_requests_connection_state")
  @@index([organizationId, testResultId, testResultExecutedAt], map: "idx_issue_creation_requests_test_result")
  @@map("issue_creation_requests")
}

model AccountToken {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    AccountTokenPurpose
  tokenHash  String              @unique(map: "uq_account_tokens_token_hash") @map("token_hash") @db.Char(64)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime?           @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt], map: "idx_account_tokens_user_purpose_created_at")
  @@index([expiresAt], map: "idx_account_tokens_expires_at")
  @@map("account_tokens")
}

model PasswordCredential {
  userId       String   @id(map: "pk_password_credentials") @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique(map: "uq_auth_sessions_refresh_token_hash") @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(50)
  replacedById     String?   @unique(map: "uq_auth_sessions_replaced_by_id") @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement AuthSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  previous    AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt], map: "idx_auth_sessions_user_id_revoked_at_expires_at")
  @@index([familyId, revokedAt], map: "idx_auth_sessions_family_id_revoked_at")
  @@map("auth_sessions")
}

model Membership {
  organizationId String         @map("organization_id") @db.Uuid
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, id], map: "pk_memberships")
  @@unique([organizationId, userId], map: "uq_memberships_organization_id_user_id")
  @@index([organizationId, role], map: "idx_memberships_organization_id_role")
  @@map("memberships")
}

model WorkspaceInvitation {
  organizationId String         @map("organization_id") @db.Uuid
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @db.Citext
  role           MembershipRole
  tokenHash      String         @unique(map: "uq_workspace_invitations_token_hash") @map("token_hash") @db.Char(64)
  invitedById    String         @map("invited_by_id") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@id([organizationId, id], map: "pk_workspace_invitations")
  @@unique([organizationId, email], map: "uq_workspace_invitations_organization_email")
  @@index([organizationId, createdAt, id], map: "idx_workspace_invitations_organization_created_at_id")
  @@index([organizationId, expiresAt], map: "idx_workspace_invitations_organization_expires_at")
  @@map("workspace_invitations")
}

model Project {
  organizationId String    @map("organization_id") @db.Uuid
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
