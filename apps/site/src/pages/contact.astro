---
import SiteLayout from '../layouts/SiteLayout.astro';
import { en } from '../content/en';
import { links } from '../config/links';
const copy = en.contact;
const mailto = `mailto:${links.contactEmail}?subject=${encodeURIComponent(copy.emailSubject)}`;
---
<SiteLayout title={copy.title} description={copy.description} page="contact">
  <main id="main">
    <section class="contact-hero section" aria-labelledby="contact-title">
      <p class="eyebrow"><span class="small-square" aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1 id="contact-title">{copy.heading}</h1>
      <p class="intro">{copy.intro}</p>
      <div class="contact-grid">
        <div class="email-panel">
          <p class="eyebrow">{copy.emailLabel}</p>
          <a class="email-address" href={mailto}>{links.contactEmail}</a>
          <a class="button primary" href={mailto}>{copy.emailCta}<span aria-hidden="true">↗</span></a>
          <p class="email-hint">{copy.emailHint}</p>
        </div>
        <div class="contact-context"><h2>{copy.contextTitle}</h2><p>{copy.contextText}</p><p class="context-note">{copy.contextNote}</p></div>
      </div>
    </section>
    <section class="contact-routes section" aria-label={en.nav.docs}>
      {copy.routes.map((route) => (
        <article><h2>{route.title}</h2><p>{route.text}</p><a class="text-link" href={links[route.kind]}>{route.action}<span aria-hidden="true">↗</span></a></article>
      ))}
    </section>
    <section class="faq section" aria-labelledby="faq-title">
      <h2 id="faq-title">{copy.faqTitle}</h2>
      <div>{copy.faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </main>
</SiteLayout>
