---
import SiteLayout from '../layouts/SiteLayout.astro';
import DecisionPreview from '../components/DecisionPreview.astro';
import { en } from '../content/en';
import { links } from '../config/links';
const copy = en.home;
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={copy.title} description={copy.description} page="home">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-square" aria-hidden="true"></span>{copy.eyebrow}</p>
        <h1 id="hero-title">{copy.heading}<br /><span>{copy.headingAccent}</span></h1>
        <p class="intro">{copy.intro}</p>
        <div class="actions">
          <a class="button primary" href={links.install}>{en.nav.start}<span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#workflow">{copy.secondary}<span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">{copy.note}</p>
      </div>
      <DecisionPreview />
    </section>
    <div class="capability-strip">
      {copy.strip.map((item) => <span><span class="small-square" aria-hidden="true"></span>{item}</span>)}
    </div>
    <section class="workflow section" id="workflow" aria-labelledby="workflow-title">
      <div class="section-heading">
        <div><p class="eyebrow">{copy.problemEyebrow}</p><h2 id="workflow-title">{copy.problemTitle}</h2></div>
        <p>{copy.problemText}</p>
      </div>
      <div class="steps">
        {copy.steps.map((step) => (
          <article><span class="step-number">{step.number}<span class="step-line" aria-hidden="true"></span></span><h3>{step.title}</h3><p>{step.text}</p></article>
        ))}
      </div>
    </section>
    <section class="features section" id="product" aria-labelledby="features-title">
      <p class="eyebrow">{copy.featuresEyebrow}</p>
      <h2 id="features-title">{copy.featuresTitle}</h2>
      <div class="feature-grid">
        {copy.features.map((feature) => <article><span class="feature-label" aria-hidden="true">{feature.number}</span><div><h3>{feature.title}</h3><p>{feature.text}</p></div></article>)}
      </div>
    </section>
    <section class="open-section section" aria-labelledby="open-title">
      <div class="open-mark" aria-hidden="true"><img src={`${base}assets/mark.svg`} alt="" width="180" height="180" /><span>↗</span></div>
      <div>
        <p class="eyebrow">{copy.openEyebrow}</p><h2 id="open-title">{copy.openTitle}</h2>
        <p class="intro">{copy.openText}</p>
        <div class="actions"><a class="button primary" href={links.repository}>{copy.source}<span aria-hidden="true">↗</span></a><a class="text-link" href={links.install}>{copy.install}<span aria-hidden="true">→</span></a></div>
        <p class="release-note">{copy.openNote}</p>
      </div>
    </section>
    <section class="invitation section" aria-labelledby="invitation-title">
      <div><p class="eyebrow">{copy.invitationEyebrow}</p><h2 id="invitation-title">{copy.invitationTitle}</h2><p>{copy.invitationText}</p></div>
      <a class="button primary" href={`${base}contact/`}>{copy.invitationCta}<span aria-hidden="true">↗</span></a>
    </section>
  </main>
</SiteLayout>
